[Unit]
Description=Zidny Projets - stockage des fichiers (SeaweedFS S3, local)
After=network.target

[Service]
User=zidny-projets
Group=zidny-projets
ExecStart=/opt/seaweedfs/weed server -dir=/var/lib/zidny-projets/s3 -ip=127.0.0.1 -ip.bind=127.0.0.1 \
    -master.port=19333 -volume.port=18080 -filer.port=18888 -volume.max=0 -master.volumeSizeLimitMB=1024 \
    -s3 -s3.port=8333 -s3.config=/etc/zidny-projets/s3.json
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
