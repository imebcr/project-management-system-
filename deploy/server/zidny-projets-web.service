[Unit]
Description=Zidny Projets - frontend Next.js (127.0.0.1:3100)
After=network.target zidny-projets-api.service

[Service]
User=zidny-projets
Group=zidny-projets
WorkingDirectory=/var/www/zidny-projets
Environment=NODE_ENV=production
Environment=BACKEND_URL=http://127.0.0.1:8100
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
