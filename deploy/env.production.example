# À copier dans /srv/zidny/app/backend/.env sur le VPS (chmod 600, propriétaire zidny).
DEBUG=False
# SECRET_KEY : python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=projets.example.com
CSRF_TRUSTED_ORIGINS=https://projets.example.com
PUBLIC_URL=https://projets.example.com

DATABASE_URL=postgres://zidny:MOT_DE_PASSE_DB@127.0.0.1:5432/zidny
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Stockage : choisissez UN bloc ----
# Cloudflare R2
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
# Supabase Storage (protocole S3)
# S3_ENDPOINT_URL=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# S3_REGION=<region du projet, ex. eu-central-1>
# S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zidny

# Clé maître du coffre (32 octets base64). La même qu'en local si vous migrez des données.
# Gardez-en une copie hors du serveur (gestionnaire de mots de passe) : sans elle, les secrets sont perdus.
VAULT_KEK=

# E-mails (invitations) : Gmail + mot de passe d'application (ou tout autre SMTP)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
EMAIL_FROM_NAME=Zidny Projets

CELERY_TASK_ALWAYS_EAGER=False
LOG_LEVEL=INFO
