# Copiez ce fichier en .env et adaptez les valeurs.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL (local : docker compose ; VPS : base PostgreSQL du serveur)
DATABASE_URL=postgres://zidny:zidny@localhost:5432/zidny
REDIS_URL=redis://localhost:6379/0

# Stockage S3-compatible
#  local       : SeaweedFS (docker compose), endpoint http://localhost:8333
#  Cloudflare R2 : S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
#  Supabase    : S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3, S3_REGION=<region>
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=zidny
S3_SECRET_KEY=zidny-dev-secret
S3_BUCKET=zidny
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

# Clé maître du coffre-fort (32 octets en base64). Générez-la avec :
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Ne la perdez pas : sans elle, les secrets ne sont plus lisibles.
VAULT_KEK=

# ---- E-mails (invitations) : Gmail + mot de passe d'application, comme le système filmmaking ----
# Gmail : 1. activez la validation en 2 étapes du compte ; 2. créez un mot de passe d'application
# (https://myaccount.google.com/apppasswords) ; 3. remplissez les deux lignes ci-dessous.
# Vides : les e-mails s'affichent dans la console de runserver (développement).
SMTP_USER=
SMTP_PASSWORD=
# Optionnels (défauts : smtp.gmail.com, 465)
SMTP_HOST=
SMTP_PORT=
EMAIL_FROM_NAME=Zidny Projets

# En local sans worker Celery, exécute les tâches de fond immédiatement.
CELERY_TASK_ALWAYS_EAGER=True
